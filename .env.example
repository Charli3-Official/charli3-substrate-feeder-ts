# Copy to .env and set your RPC URLs
# RPCs for different chains
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
RPC_BSC=https://bsc-dataseed.binance.org
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/REPLACE_ME
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/REPLACE_ME
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_OPTIMISM=https://mainnet.optimism.io

# Substrate node URL
SUBSTRATE_NODE_URL=ws://127.0.0.1:9948

# Interval in seconds (default 60)
INTERVAL_SECONDS=60
