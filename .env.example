# Copy to .env and set your RPC URLs
# RPCs for Ethereum/Base/Polygon
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/REPLACE_ME
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/REPLACE_ME

# Substrate nodes are set per service in docker-compose.yml
# Interval in seconds (default 300)
INTERVAL_SECONDS=300
